    "/auth/signup": {
      "post": {
        "description": "User registration.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "example": "user@example.com"
                },
                "name": {
                  "example": "user name"
                },
                "password": {
                  "example": "securepassword"
                },
                "role": {
                  "example": "user"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "description": "User login.",
        "parameters": [
          {
            "name": "body",
